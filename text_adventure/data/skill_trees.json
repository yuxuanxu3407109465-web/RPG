  "skills": [
    {
      "id": "long_stance",
      "tree": "blade",
      "branch": "long",
      "name": "长刃姿态",
      "cost": 1,
      "description": "手持至少一把长刃武器时（双持也可以），可以在进攻、防守、决斗三种姿态之间切换，同时只能开启一个，切换不占用行动。之后学会的长刃技能，在不同姿态下会获得不同的额外效果。"
    },
    {
      "id": "long_slash",
      "tree": "blade",
      "branch": "long",
      "name": "随势斩",
      "type": "active",
      "cost": 1,
      "requires": [
        "long_stance"
      ],
      "description": "用长刃挥出一斩，造成武器伤害的 100%。没有开启姿态时只是一次普通的斩击，开启姿态后会附带对应的额外效果。",
      "stance_effects": {
        "long_attack": "横扫：攻击近战范围内的所有敌对目标，对每个目标造成武器伤害的 (50 + 敏捷×5)%（暂定）。",
        "long_defense": "撤步：斩击后向后撤开 2 + 敏捷÷5 米（向下取整，暂定），并且不会受到借机攻击。",
        "long_duel": "卸刃：无视目标 (10 + 敏捷×2)% 的护甲，并使目标缴械：武器掉在脚下，捡回来要花行动点（暂定）。"
      },
      "weapon_type": "long_blade"
    },
    {
      "id": "short_bleed",
      "tree": "blade",
      "branch": "short",
      "name": "放血",
      "type": "active",
      "cost": 1,
      "weapon_type": "short_blade",
      "description": "刀锋钻进护甲的缝隙：发起一次无视目标 (10 + 敏捷×2)% 护甲的攻击，并使目标流血，每回合损失 2 + 敏捷÷2 点生命值（向下取整），持续 3 回合（暂定）。"
    },
