  "npcs": {
    "neighbor": {
      "name": "老陈",
      "aliases": [
        "邻居",
        "陈",
        "neighbor"
      ],
      "description": "对门的中年邻居，胡子拉碴，手里攥着一把菜刀。",
      "dialogue": [
        "“小声点！楼下那些东西听得见。”",
        "“街对面便利店还没被抢光，就是卷帘门锁死了。”",
        "“我车后备箱里有根撬棍，停在地下停车场 B 区。可那里断电了，黑得很，我不敢去。”"
      ]
    },
    "clerk": {
      "name": "阿杰",
      "aliases": [
        "店员",
        "杰",
        "clerk"
      ],
      "description": "二十出头的便利店店员，脸色苍白，看起来好几天没睡了。",
      "dialogue": [
        "“你……你是活人？吓死我了，我还以为门要被它们撞开了。”",
        "“剩下的东西你拿吧，我一个人也守不住。”",
        "“听说城西体育馆那边有军方的救援点，不知道是真是假。”"
      ]
    }
